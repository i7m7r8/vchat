{
  "identifier": "default",
  "description": "Default capabilities for Vchat",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:event:allow-emit",
    "core:event:allow-listen",
    "core:window:default",
    "core:window:allow-create",
    "core:window:allow-show",
    "core:window:allow-close",
    "core:window:allow-set-title"
  ]
}
